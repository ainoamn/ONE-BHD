# BHD Portal — local/production secrets
# Copy to .env.local  |  Never commit real values
# Neon console: https://console.neon.tech/app/org-broad-surf-16375800/projects

# PostgreSQL from Neon (use the pooled connection string for Vercel)
DATABASE_URL=

# Session signing — openssl rand -base64 48
AUTH_SECRET=

# Optional separate secret for OIDC ID/access tokens (defaults to AUTH_SECRET)
IDENTITY_TOKEN_SECRET=

# Frozen issuer after DNS: https://id.bhd-om.com
BHD_IDENTITY_ISSUER=

# Per-product OAuth client secrets (openssl rand -hex 32). If omitted, derived from AUTH_SECRET.
BHD_OAUTH_CLIENT_SECRET_PORTAL=
BHD_OAUTH_CLIENT_SECRET_WAZEN=
BHD_OAUTH_CLIENT_SECRET_HISABY=
BHD_OAUTH_CLIENT_SECRET_NASAB=

# Same Google OAuth Client ID as HISAB (optional until domain is ready)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
