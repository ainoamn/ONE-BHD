# Portal Google sign-in
# Copy to .env.local for development. Set the same keys in Vercel for production.
# Never commit real secrets.

# Same Google OAuth 2.0 Client ID used by HISAB / حسابي
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Session signing key — generate with: openssl rand -base64 48
AUTH_SECRET=
